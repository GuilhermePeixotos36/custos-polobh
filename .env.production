# ------------------------- TRAVAS DE HOMOLOGAÇÃO -------------------------
# Enquanto o app está sendo conferido pela equipe, nenhum e-mail pode chegar a
# fornecedor ou cliente de verdade. As duas travas são independentes:
#
#   VITE_EMAIL_DESTINO_REAL  toda mensagem é desviada para a caixa de teste
#                            (ver src/lib/email/seguranca.ts) enquanto for
#                            false. Esta é a rede de segurança — só vira true
#                            no dia da virada.
#   VITE_DISPARO_FORNECEDOR  habilita os botões de Disparar OS e de enviar
#                            cronograma. Falso = a equipe não consegue nem
#                            clicar. Para testar o disparo, ligue SÓ esta: o
#                            e-mail continua caindo na caixa de teste.
VITE_EMAIL_DESTINO_REAL=false
VITE_DISPARO_FORNECEDOR=false
