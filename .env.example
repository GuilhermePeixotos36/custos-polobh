# Fonte de dados: "supabase" (100% banco). "mock" foi removido do app.
VITE_DATA_SOURCE=supabase

# Feature flags
VITE_FEATURE_CNPJ=true     # consulta de CNPJ via BrasilAPI (API pública)
# Opcional: endpoint fiscal próprio. Use {cnpj} na URL; deve retornar
# { "inscricaoEstadual": "...", "inscricaoMunicipal": "..." }.
# VITE_CNPJ_FISCAL_ENDPOINT=https://api.exemplo.com/cnpj/{cnpj}/inscricoes
VITE_FEATURE_IA=false      # descritivo por IA (precisa de Edge Function)
# VITE_AI_ENDPOINT=https://<projeto>.supabase.co/functions/v1/descritivo-ia

# E-mails (Brevo) — o frontend chama a Edge Function `send-email` via
# supabase.functions.invoke (auth automática; NÃO precisa de endpoint aqui).
VITE_FEATURE_EMAIL=true    # true: envia de verdade; false: simulado (nada sai)
# Segredos da função (setar no Supabase, NÃO aqui):
#   supabase secrets set BREVO_API_KEY=...
#   supabase secrets set BREVO_SENDER_EMAIL=noreply@polobh.com.br
#   supabase secrets set BREVO_SENDER_NAME="Pólobh Eventos"
#   supabase secrets set BREVO_REPLY_TO=contato@polobh.com.br   # respostas (noreply não recebe)
#   supabase secrets set CRON_SECRET=<segredo-aleatorio-longo>   # header x-cron-secret do agendamento

# Supabase (projeto qtubypczpkkrdbvgdziu)
VITE_SUPABASE_URL=https://qtubypczpkkrdbvgdziu.supabase.co
# Pegue a chave em: Supabase > Project Settings > API > Project API keys > anon/public
VITE_SUPABASE_ANON_KEY=
