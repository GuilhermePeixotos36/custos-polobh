# Fonte de dados: "supabase" (100% banco). "mock" foi removido do app.
VITE_DATA_SOURCE=supabase

# Feature flags
VITE_FEATURE_CNPJ=true     # consulta de CNPJ via BrasilAPI (API pública)
VITE_FEATURE_IA=false      # descritivo por IA (precisa de Edge Function)
# VITE_AI_ENDPOINT=https://<projeto>.supabase.co/functions/v1/descritivo-ia

# E-mails (Brevo) — frontend chama a Edge Function; a chave fica no servidor
VITE_FEATURE_EMAIL=false   # com false, os envios são SIMULADOS (nada sai)
# VITE_EMAIL_ENDPOINT=https://<projeto>.functions.supabase.co/send-email
# Segredos da função (no Supabase, não aqui): BREVO_API_KEY, BREVO_SENDER_EMAIL, BREVO_SENDER_NAME

# Supabase (projeto qtubypczpkkrdbvgdziu)
VITE_SUPABASE_URL=https://qtubypczpkkrdbvgdziu.supabase.co
# Pegue a chave em: Supabase > Project Settings > API > Project API keys > anon/public
VITE_SUPABASE_ANON_KEY=
